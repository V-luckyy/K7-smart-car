<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>k7_follower</name>
  <version>0.1.0</version>
  <description>多机编队跟随包（Leader-Follower v1）：订阅 leader 融合位姿(/leader/odom_combined)复刻速度 + 纵向间距保持 + 前红外安全刹停，输出 cmd_vel_follower（经 twist_mux 仲裁进底盘）</description>
  <maintainer email="user@todo.todo">k7</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>k7_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
