<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>k7_bringup</name>
  <version>0.1.0</version>
  <description>K7 智能小车核心启动包：STM32(C50X 底盘) 串口通信节点（含 cmd_vel 看门狗）、EKF/Madgwick 配置、udev 规则、核心 launch</description>
  <maintainer email="user@todo.todo">k7</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>turtlesim</depend>
  <depend>k7_msgs</depend>
  <!-- wjwwood serial 库已 vendor 到 third_party/serial，无 serial 依赖 -->
  <depend>robot_localization</depend>
  <depend>imu_filter_madgwick</depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
