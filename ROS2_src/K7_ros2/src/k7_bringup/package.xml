<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>k7_bringup</name>
  <version>0.1.0</version>
  <description>K7 task profiles, shared configuration and bounded STM32 serial bridge</description>
  <maintainer email="user@todo.todo">k7</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- wjwwood serial 库已 vendor 到 third_party/serial，无 serial 依赖 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>k7_camera</exec_depend>
  <exec_depend>k7_control</exec_depend>
  <exec_depend>k7_tasks</exec_depend>
  <exec_depend>k7_experiment</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
